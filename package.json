    "check:contracts": "node scripts/compile-contracts.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "jsdom": "26.1.0",
    "solc": "0.8.28"
  }
}
